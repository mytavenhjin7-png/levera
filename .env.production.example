# LEVERA — settings for the live server. Copy to .env (docker compose) or enter them as
# environment variables in Railway / Render. Never commit the filled-in file.

# Your web address, e.g. https://levera.mn (used for QPay callbacks, links and the sitemap)
PUBLIC_URL=https://levera.mn
ALLOWED_ORIGIN=https://levera.mn
PORT=8787

# Admin panel password: make it long and random (e.g. 24+ letters and digits)
ADMIN_TOKEN=

# Database. docker compose: only MYSQL_PASSWORD is needed (it also creates the MySQL server).
# Railway / other hosts: either one MYSQL_URL=mysql://user:password@host:3306/levera
# or MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE (Railway's MYSQLHOST… names also work).
DB_DRIVER=mysql
MYSQL_PASSWORD=
# MYSQL_URL=

# AI concierge (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# QPay merchant account (empty = demo mode: orders are created but no real payment is taken)
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=

# Telegram alerts for new and paid orders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

HICARGO_SYNC=on
