# LEVERA live settings on Firebase. Copy to functions/.env and fill in. Never share or upload this file anywhere else.
PUBLIC_URL=https://www.levera.mn
ALLOWED_ORIGIN=https://www.levera.mn

# Admin panel password (admin.html): long and random
ADMIN_TOKEN=

# Database: TiDB Cloud Serverless (tidbcloud.com → your cluster → Connect)
DB_DRIVER=mysql
MYSQL_SSL=true
MYSQL_HOST=
MYSQL_PORT=4000
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=levera

# AI concierge
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# QPay (after the contract; empty = demo mode)
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=

# Telegram order alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

HICARGO_SYNC=on
