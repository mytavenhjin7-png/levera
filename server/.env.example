# LEVERA store server settings. Copy this file to server/.env and fill in your own values.
# Never put these keys in js/ (browser code) — they stay on the server only.

PORT=8787
# Your website address in production (used for CORS and the QPay callback), e.g. https://levera.mn
ALLOWED_ORIGIN=*
PUBLIC_URL=http://localhost:8787

# Database. mysql = Laragon / any MySQL 8 (the database and tables are created automatically).
# sqlite = built-in file database in data/levera.db, no server needed.
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=levera

# Admin panel password (admin.html). Leave empty and one is generated into data/admin-token.txt.
ADMIN_TOKEN=

# QPay merchant (from your QPay contract). Leave empty = demo mode with an example QR.
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
# QPAY_BASE=https://merchant-sandbox.qpay.mn   # sandbox while testing; default is https://merchant.qpay.mn

# Telegram order alerts: create a bot with @BotFather, then get your chat id from /getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI concierge: create a free key at https://aistudio.google.com/apikey and paste it here. Empty = built-in answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# HiCargo live rates are pulled every 6 hours. Set to off to keep the rates you enter in admin.
HICARGO_SYNC=on
